# Betty AI — example signing configuration
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill in your
# own values. If `keystore.properties` is absent, `assembleRelease` produces an
# unsigned APK instead of failing.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore betty-release.keystore \
#     -alias betty -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to the project root.

storeFile=betty-release.keystore
storePassword=change-me
keyAlias=betty
keyPassword=change-me
